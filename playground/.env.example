# Copy to playground/.env and pass --env-file playground/.env to docker compose, if you want to
# override anything below. Every value already has a working default baked into
# docker-compose.yml / each host's config/settings.py — this file exists only to document what's
# overridable, mirroring ../../cleanup_app/playground/.env.example's own convention.

# The four seeded personas' shared password (both hosts, both databases) — manage.py seed_users
# reads this so it never needs to be hardcoded in a management command.
PLAYGROUND_PASSWORD=playground-demo-not-a-secret
